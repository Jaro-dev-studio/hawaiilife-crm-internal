# Database
# SQLite database file location (relative to project root)
DATABASE_URL="file:./dev.db"

# Auth.js Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-please-change-in-production"

# Google OAuth (configure in Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
# Required callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Admin impersonation password
# This allows admins to sign in as non-admin users
ADMIN_PASS="your-secure-admin-password-here"
